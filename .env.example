# Local development only. Copy to .env and replace every value outside local use.
NODE_ENV=development
LOG_LEVEL=debug

# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=fieldforge
DB_USER=fieldforge
DB_PASSWORD=fieldforge_local_only
MYSQL_ROOT_PASSWORD=fieldforge_root_local_only
DATABASE_URL=mysql://fieldforge:fieldforge_local_only@127.0.0.1:3306/fieldforge

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=fieldforge_redis_local_only

# RabbitMQ
RABBITMQ_HOST=127.0.0.1
RABBITMQ_PORT=5672
RABBITMQ_USER=fieldforge
RABBITMQ_PASSWORD=fieldforge_rabbit_local_only
RABBITMQ_MANAGEMENT_PORT=15672

# Application URLs
PORT=8000
API_GATEWAY_URL=http://localhost:8000
AUTH_SERVICE_URL=http://localhost:8001
WORK_ORDER_SERVICE_URL=http://localhost:8002
DISPATCH_SERVICE_URL=http://localhost:8003
BILLING_SERVICE_URL=http://localhost:8004
NOTIFICATION_SERVICE_URL=http://localhost:8005
WEB_PORT=5173

# Local observability ports and credentials
JAEGER_UI_PORT=16686
PROMETHEUS_PORT=9090
GRAFANA_PORT=3009
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=fieldforge_grafana_local_only

# Application secrets and provider credentials are intentionally blank.
JWT_SECRET=
STRIPE_SECRET_KEY=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_DELIVERABLES_BUCKET=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
FIREBASE_PROJECT_ID=

